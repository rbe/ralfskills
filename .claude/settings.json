{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/hooks/scripts/block-bare-git-add.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/hooks/scripts/block-python-file-write.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
