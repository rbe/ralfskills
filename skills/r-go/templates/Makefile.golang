# The Makefile of a Go project on project.mk, from the template of the
# r-go skill.
#
# Go runs through $(GO), which is Podman on this machine. gofmt is the
# formatter. go vet is the linter. The Go caches are container volumes,
# not directories of the project. A project with no integration entry
# keeps that command as `true`.
#
# A new project, or a project with no go.mod yet, runs
#   make go-tooling
# once. MODULE sets the module path, for example:
#   make go-tooling MODULE=github.com/acme/app
#
# lint, test, and build fail until the first Go file exists. coverage
# and test-changed fail until the first unit test exists.

# The module path of a new project. NAME comes from project.mk: the
# repository name of the remote origin, else the directory name.
MODULE ?= example.com/$(NAME)
GO_IMAGE ?= docker.io/library/golang:1.25-bookworm
# The Go caches are volumes of this project. Two projects on one machine
# do not share a volume, so their containers do not wait for each other.
GO_CACHE ?= $(notdir $(CURDIR))
GO_OPTS = -e HOME=/tmp -e CI -e GOFLAGS=-buildvcs=false \
	-v $(GO_CACHE)-gocache:/tmp/.cache/go-build -v $(GO_CACHE)-gomod:/go/pkg/mod \
	-v "$(CURDIR)":/work:Z -w /work
GO_RUN = podman run --rm $(GO_OPTS) $(GO_IMAGE)
GO = $(GO_RUN) go

SETUP_CMD = $(GO) mod download
# A project that ships a binary sets BIN to the name of the binary.
# `make build` then writes build/$(BIN) from the package BIN_PKG, and
# `make run ARGS='...'` runs that package. With BIN empty, `make build`
# compiles every package and writes no file, which is right for a
# library.
#
# Go runs in a Linux container, so build/$(BIN) is a Linux binary. For a
# binary of another machine, set GOOS and GOARCH:
#   make build GOOS=darwin GOARCH=arm64
# `make run` does not read build/. It compiles and runs in the container.
BIN ?=
BIN_PKG ?= ./cmd/$(BIN)
ARGS ?=
BUILD_CMD = $(if $(BIN),mkdir -p build && $(GO_RUN) env $(if $(GOOS),GOOS=$(GOOS)) $(if $(GOARCH),GOARCH=$(GOARCH)) go build -o build/$(BIN) $(BIN_PKG),$(GO) build ./...)
TEST_CMD = $(GO) test ./...
INTEGRATION_CMD = true
# gofmt reads the Go files of the packages of the project and no other
# file. It does not walk a directory, so it does not read .claude/ when
# the root of the repository is a package.
GO_FILES = go list -f "{{\$$d := .Dir}}{{range .GoFiles}}{{\$$d}}/{{.}} {{end}}{{range .TestGoFiles}}{{\$$d}}/{{.}} {{end}}{{range .XTestGoFiles}}{{\$$d}}/{{.}} {{end}}" ./...
FORMAT_CMD = $(GO_RUN) sh -c 'files=$$(gofmt -l $$($(GO_FILES))) || exit 1; if [ -n "$$files" ]; then printf "%s\n" "gofmt would change:" "$$files"; exit 1; fi'
FORMAT_FIX_CMD = $(GO_RUN) sh -c 'gofmt -w $$($(GO_FILES))'
LINT_CMD = $(GO) vet ./...
COVERAGE_CMD = set -eu; \
	base=$$(git merge-base HEAD origin/$(DEFAULT_BRANCH) 2>/dev/null || git merge-base HEAD $(DEFAULT_BRANCH) 2>/dev/null || git rev-parse -q --verify HEAD 2>/dev/null || git hash-object -t tree /dev/null); \
	git add -N .; \
	git diff "$$base" > build/coverage/change.diff; \
	$(GO_RUN) sh -c 'set -eu; mkdir -p build/coverage/go; for pkg in $$(go list ./...); do go test -coverpkg=./... -coverprofile="build/coverage/go/$$(printf "%s" "$$pkg" | tr "/" "_").out" "$$pkg"; done'; \
	$(PYTHON) .claude/skills/r-project-report/scripts/go_cover_map.py; \
	REPORT=build/coverage/coverage.xml $(DIFF_COVER)
TEST_CHANGED_CMD = chosen=$$($(PYTHON) .claude/skills/r-project-report/scripts/changed_tests.py --print) || exit 1; \
	chosen=$$(printf '%s' "$$chosen" | tr '\n' ' '); \
	if [ -z "$$chosen" ]; then printf '%s\n' "test-changed: no test covers the changed files. make test runs the full suite."; \
	else printf 'test-changed: %s\n' "$$chosen"; $(GO) test $$chosen; fi

include .claude/skills/r-project-setup/project.mk

# Project targets.

.PHONY: go
go: ## Run go in Podman on this machine. Set ARGS.
	@set -eu; \
	if [ -z "$(ARGS)" ]; then printf '%s\n' "go: set ARGS to the go arguments." >&2; exit 1; fi
	$(GO) $(ARGS)

.PHONY: run
run: ## Run the program in Podman on this machine. Set BIN. ARGS are its arguments.
	@set -eu; \
	if [ -z "$(BIN)" ]; then printf '%s\n' "run: set BIN to the name of the binary. A library has no program to run." >&2; exit 1; fi; \
	tty=""; if [ -t 0 ] && [ -t 1 ]; then tty="-it"; fi; \
	podman run --rm $$tty $(GO_OPTS) $(GO_IMAGE) go run $(BIN_PKG) $(ARGS)

# One target for the Go tooling, every step through Podman:
# 1. go.mod (go mod init MODULE) when missing
# 2. .editorconfig from r-project-setup when missing
# 3. build/ and bin/ in .gitignore, each line when missing
# 4. make format-fix, when the project has a Go package already
# gofmt and go vet come with the Go image, so nothing is installed.
# A file already in the project stays as it is.
.PHONY: go-tooling
go-tooling: ## Set up go.mod, EditorConfig, and .gitignore, then format
	@set -eu; \
	if [ ! -f go.mod ]; then $(GO) mod init $(MODULE); fi; \
	if [ ! -f .editorconfig ]; then cp .claude/skills/r-project-setup/templates/editorconfig .editorconfig; fi; \
	touch .gitignore; \
	for line in build/ bin/; do \
	  if ! grep -qx "$$line" .gitignore; then printf '%s\n' "$$line" >> .gitignore; fi; \
	done; \
	if [ -n "$$($(GO) list ./... 2>/dev/null)" ]; then $(MAKE) --no-print-directory format-fix; \
	else echo "go-tooling: no Go package yet, so nothing to format."; fi
